# ===================================
# 开发服务器环境
# 部署到开发/测试服务器
# ===================================

VITE_ENV=staging

# API 基础地址（开发服务器）
VITE_API_BASE_URL=https://dev-api.kava-admin.example.com

# 禁用 Mock
VITE_ENABLE_MOCK=false

# 开发工具
VITE_ENABLE_DEVTOOLS=true

# OAuth2 配置
VITE_OAUTH_REDIRECT_URI=https://staging-admin.kava-admin.example.com/oauth/callback
VITE_OAUTH_CLIENT_ID=kava_admin_staging